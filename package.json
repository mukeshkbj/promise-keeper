    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/bridge": "^7.2.1",
    "@forge/kvs": "^2.1.1",
    "@forge/llm": "^1.0.9",
    "@forge/react": "^12.4.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1"
